{{- $pages := partial "helper/pages.html" .Site.Home -}}
{{- $result := slice -}}

{{- range $pages -}}
    {{- $data := dict "title" .Title "date" .Date "permalink" .RelPermalink "content" (.Plain) -}}

    {{- /* michael.gr: Use the post's leading body image instead of the front-matter `image` field. */ -}}
    {{- $image := partial "helper/cover-image" . -}}
    {{- if $image -}}
        {{- $data = merge $data (dict "image" $image.Permalink) -}}
    {{- end -}}

    {{- $result = $result | append $data -}}
{{- end -}}

{{ jsonify $result }}